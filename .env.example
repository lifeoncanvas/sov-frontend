# Copy to .env (git-ignored) and adjust. All values are optional.

# Development: where `npm start` forwards /api, /uploads and /sitemap.xml. Default http://localhost:8090.
# VITE_API_TARGET=http://localhost:8090

# Production build: full origin of the backend API when it is not served from the storefront's own domain.
# VITE_API_URL=https://api.lichtsignaturesouvenirs.store

# Google Analytics 4 measurement id.
# VITE_GA_ID=

# Cloudflare Turnstile site key (the backend must have TURNSTILE_SECRET_KEY). Set both or neither.
# VITE_TURNSTILE_SITE_KEY=
